{
  "name": "earthatlas",
  "version": "0.1.0",
  "private": true,
  "description": "Discover species living around you — powered by iNaturalist",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-dev-data.js",
    "dev": "vite",
    "build": "node scripts/prebuild-stats.js && node scripts/prebuild-species.js && node scripts/generate-sitemap.js && node scripts/generate-birdsong-stations.js && vite build && node scripts/generate-route-html.js",
    "prebuild:species": "node scripts/prebuild-species.js",
    "preview": "vite preview",
    "dev:parcel-tiles": "node scripts/bake-parcels/serve-tiles.mjs",
    "lint": "eslint src --ext .js,.jsx",
    "test:ships": "node --env-file-if-exists=.env.local --test lib/ships/test/*.test.js",
    "ships:migrate": "node --env-file=.env.local scripts/ships/migrate.mjs",
    "ships:import-gfw": "node --env-file=.env.local scripts/ships/import-gfw.mjs",
    "ships:import-mc": "node --env-file=.env.local scripts/ships/import-mc.mjs",
    "ships:import-wikidata": "node --env-file=.env.local scripts/ships/import-wikidata.mjs",
    "ships:import-commons": "node --env-file=.env.local scripts/ships/import-commons.mjs",
    "ships:import-fcc": "node --env-file=.env.local scripts/ships/import-fcc.mjs",
    "ships:import-psix": "node --env-file=.env.local scripts/ships/import-psix.mjs",
    "ships:import-tc": "node --env-file=.env.local scripts/ships/import-tc.mjs",
    "ships:reresolve": "node --env-file=.env.local scripts/ships/reresolve.mjs",
    "ships:import-incidents-cgmix": "node --env-file=.env.local scripts/ships/import-incidents-cgmix.mjs",
    "ships:import-incidents-ecology": "node --env-file=.env.local scripts/ships/import-incidents-ecology.mjs",
    "ships:import-incidents-names": "node --env-file=.env.local scripts/ships/import-incidents-names.mjs",
    "ships:import-countries": "node --env-file=.env.local scripts/ships/import-ports.mjs countries",
    "ships:import-wpi": "node --env-file=.env.local scripts/ships/import-ports.mjs wpi",
    "ships:import-locode": "node --env-file=.env.local scripts/ships/import-ports.mjs locode",
    "ships:import-anchorages": "node --env-file=.env.local scripts/ships/import-ports.mjs anchorages",
    "ships:match-ports": "node --env-file=.env.local scripts/ships/import-ports.mjs match",
    "ships:import-anchorages-us": "node --env-file=.env.local scripts/ships/import-anchorages.mjs us",
    "ships:import-anchorages-ca": "node --env-file=.env.local scripts/ships/import-anchorages.mjs ca",
    "ships:import-anchorages-nondesignated": "node --env-file=.env.local scripts/ships/import-anchorages.mjs nondesignated",
    "ships:import-portwatch": "node --env-file=.env.local scripts/ships/import-portwatch.mjs",
    "ships:import-climatetrace-ports": "node --env-file=.env.local scripts/ships/import-climatetrace-ports.mjs",
    "ships:import-official-ports": "node --env-file=.env.local scripts/ships/import-official-ports.mjs",
    "ships:import-terminals": "node --env-file=.env.local scripts/ships/import-terminals.mjs",
    "ships:import-facilities": "node --env-file=.env.local scripts/ships/import-facilities.mjs",
    "ships:import-bc-permits": "node --env-file=.env.local scripts/ships/import-bc-permits.mjs",
    "ships:import-gisis": "node --env-file=.env.local scripts/ships/import-gisis.mjs",
    "ships:import-eu-mrv": "node --env-file=.env.local scripts/ships/import-eu-mrv.mjs",
    "ships:import-mep": "node --env-file=.env.local scripts/ships/import-mep.mjs",
    "ships:export-type-lookup": "node --env-file=.env.local scripts/ships/export-type-lookup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@neondatabase/serverless": "^1.0.2",
    "@photostructure/tz-lookup": "11.7.0",
    "@sentry/react": "^10.53.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/blob": "^2.4.0",
    "h5wasm": "^0.10.3",
    "mapbox-gl": "^3.24.1",
    "mp4-muxer": "^5.2.2",
    "netcdfjs": "^4.0.0",
    "pmtiles": "^4.4.1",
    "posthog-js": "^1.356.1",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.3.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "sharp": "^0.34.5",
    "vite": "^5.4.1"
  }
}

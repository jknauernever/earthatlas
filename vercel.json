{
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "rewrites": [
    {
      "source": "/forestmonitor",
      "destination": "/forestmonitor.html"
    },
    {
      "source": "/fire",
      "destination": "/fire.html"
    },
    {
      "source": "/quakes",
      "destination": "/quakes.html"
    },
    {
      "source": "/carbon",
      "destination": "/carbon.html"
    },
    {
      "source": "/birdsong",
      "destination": "/birdsong.html"
    },
    {
      "source": "/happywhale",
      "destination": "/happywhale.html"
    },
    {
      "source": "/shiptraffic",
      "destination": "/shiptraffic.html"
    },
    {
      "source": "/inmotion",
      "destination": "/inmotion.html"
    },
    {
      "source": "/systems",
      "destination": "/inmotion"
    },
    {
      "source": "/((?!api/|@)[^.]*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|robots\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:jpg|jpeg|png|webp|gif|svg|ico|woff2?))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/news/dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/birdsong/refresh",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/nifc-snapshot",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/cron/gfs-wind",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=currents",
      "schedule": "45 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=sst",
      "schedule": "15 8,20 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=waves",
      "schedule": "5 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=airtemp",
      "schedule": "35 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=sstanom",
      "schedule": "20 8,20 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=hotspots",
      "schedule": "10 */3 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=fire-daily",
      "schedule": "35 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=hrrr-smoke",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=hrrr-smoke&tape=1",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=aerosol",
      "schedule": "50 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=sst-year&tape=1",
      "schedule": "50 19 * * 5"
    },
    {
      "path": "/api/cron/systems-bake?ds=sstanom-year&tape=1",
      "schedule": "55 19 * * 5"
    },
    {
      "path": "/api/cron/systems-bake?ds=smoke",
      "schedule": "52 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=dust",
      "schedule": "54 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=smoke&tape=1",
      "schedule": "35 1,13 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=dust&tape=1",
      "schedule": "45 1,13 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=aerosol&tape=1",
      "schedule": "25 1,13 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=airtemp&tape=1",
      "schedule": "40 2,8,14,20 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=waves&tape=1",
      "schedule": "45 2,8,14,20 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=sst&tape=1",
      "schedule": "30 19 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=sstanom&tape=1",
      "schedule": "35 19 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=co",
      "schedule": "56 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=pm25",
      "schedule": "58 */6 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=co&tape=1",
      "schedule": "50 1,13 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=pm25&tape=1",
      "schedule": "55 1,13 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=co2",
      "schedule": "5 3,9 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=methane",
      "schedule": "10 3,9 * * *"
    },
    {
      "path": "/api/cron/systems-bake?ds=methane-plumes",
      "schedule": "25 4 * * *"
    }
  ]
}
